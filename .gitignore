# .gitignore
# ---- 凭据：永不提交 ----
.env
.env.*
!.env.example
.env.bt
.gh_token
config/secrets.local.json
config/secrets*.json
*.local.json
cookies/
credentials_local.py

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- 数据与运行产物（体积大 / 含账户信息，不入库）----
data/
output/
outputs/
log/
logs/
*.log
*.sqlite
*.sqlite-journal
*.npy
*.npz
*.bin
*.pkl
*.parquet

# ---- IDE ----
.vscode/
.idea/

# ---- OS ----
Thumbs.db
.DS_Store

# ---- WorkBuddy 内部状态（含记忆日志与团队协作数据）----
.workbuddy/
