# .gitignore
# ---- 凭据：永不提交 ----
.env
.env.*
!.env.example
.env.bt
.gh_token
config/secrets.local.json
config/secrets*.json
*.local.json
cookies/
credentials_local.py

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- 数据与运行产物（仅锚定仓库根目录；不要用裸 data/ output/，会误伤 research/**/data 等代码包）----
/data/
/output/
/outputs/
/log/
/logs/
*.log
*.sqlite
*.sqlite-journal
*.npy
*.npz
*.bin
*.pkl
*.parquet

# ---- IDE ----
.vscode/
.idea/

# ---- OS ----
Thumbs.db
.DS_Store

# ---- WorkBuddy 内部状态（含记忆日志与团队协作数据）----
/.workbuddy/
