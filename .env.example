# 复制本文件为 .env 后填入你自己的凭据。
# 结构由 credentials.py 读取，section 名称不要修改。
# 真实 .env / .env.bt 已在 .gitignore 中，切勿提交。

[tushare]
# Tushare Pro token，格式形如 40 位十六进制字符串
token = YOUR_TUSHARE_TOKEN

[joinquant]
# 聚宽 JQData 账号（用于 jqdatasdk.auth，非聚宽网站登录页密码可另设）
username = YOUR_JQ_USERNAME
password = YOUR_JQ_PASSWORD

[worldquant]
# 可选：WorldQuant BRAIN 凭据，不参与因子挖掘主链路
email = YOUR_WQ_EMAIL
password = YOUR_WQ_PASSWORD

# ---- LLM（不写入本文件时，可用进程环境变量注入）----
# 读取优先级见 research/factor_alchemy/llm_client.py::resolve_api_key_with_source
#   1) 显式传参  2) 进程环境变量 DEEPSEEK_API_KEY
#   3) 本文件 / .env.local / config/secrets.local.json  4) Windows 用户环境变量
# 示例（请勿填写真实值到示例文件）：
# DEEPSEEK_API_KEY = <DEEPSEEK_API_KEY>
